# Names only. Values stay on the M3. Never commit a filled copy of this file.
#
# AGENDA_TOKEN                 bearer the desk sends. openssl rand -hex 32
# GOOGLE_CLIENT_ID             OAuth client id
# GOOGLE_CLIENT_SECRET         OAuth client secret
# GOOGLE_REFRESH_TOKEN         printed once by auth.mjs
# TRIPIT_ICS_URL               optional. Leave unset to read TripIt through Google.
# AGENDA_MACHINE_ID            optional. Compared with this Mac's IOPlatformUUID.
# AGENDA_EXPECT_HOST           default Agentics-MacBook-Air-5.local
# AGENDA_ALLOW_OTHER_HOST      set to 1 only if this is not the desk machine
# AGENDA_BIND                  default 127.0.0.1
# AGENDA_PORT                  default 8741
# AGENDA_SYNC_MINUTES          default 30, clamped to 15–180
# AGENDA_SYNC_DELAY_SECONDS    default 20
# AGENDA_ORIGINS               comma-separated extra browser origins
# AGENDA_TLS_CERT              PEM path. Set with the key, or set neither.
# AGENDA_TLS_KEY               PEM path.
# AGENDA_CACHE                 default ~/.agenda/cache.json
