# Cloudflare Pages edge-cache policy.
#
# Why this file exists: Pages serves assets with a 4-hour edge cache and
# ignores query strings in its cache key. So a deploy could be verified
# green — version.json fresh from one edge entry — while app.js kept
# serving the PREVIOUS build from another for up to four hours. Every
# client-side staleness defence (network-first SW, self-heal) sat on top
# of a CDN that was itself the stale layer. "Nothing changed whatsoever"
# was, for the fourth time, accurate.
#
# no-cache does not mean "don't cache" — it means the edge must
# revalidate with the origin before serving, which costs one conditional
# request and makes a deploy visible everywhere in seconds.
#
# FIFTH LAYER (2026-08-07): these rules land on *.pages.dev. The custom
# domain nonarkara.org is proxied through the zone, and the zone's
# Browser Cache TTL rewrites Cache-Control on JS/CSS back to
# max-age=14400. Until that zone setting is "Respect Existing Headers",
# /heal + self-heal is what actually clears a visitor's disk cache.
# ship.sh warns when the custom domain still serves the 4h header.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-j799OgeCQWJ7WHQmR+XR+J4Z9v5NXkHqM811pPMApf8=' 'sha256-NqizBrOnYS9ghKUw9h5To7QoyURzCnoYX/49t64nBlk=' 'sha256-09+iC3cfZoRHc4znTvMsaqNfA3+z2zt+nE8Yd8GuPMs=' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.de https://tile.openstreetmap.org https://a.tile.openstreetmap.fr; media-src 'self' blob: https://api.nonarkara.org; connect-src 'self' https://api.nonarkara.org https://open.er-api.com https://api.open-meteo.com https://air-quality-api.open-meteo.com https://hacker-news.firebaseio.com https://api.github.com https://cloudflareinsights.com; frame-src https://games.nonarkara.org; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Permissions-Policy: accelerometer=(self), gyroscope=(self), magnetometer=(self), geolocation=(self), camera=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Strict-Transport-Security: max-age=31536000

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

/mixtape.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-store

# Self-heal / ?reset hit this to wipe HTTP disk cache. Zone TTL can
# leave app.js sticky after SW caches are cleared; Clear-Site-Data is
# the browser API that actually drops that layer.
/heal
  Cache-Control: no-store
  Clear-Site-Data: "cache"

# Fingerprinted / immutable media — leave them hot.
/music/*
  Cache-Control: public, max-age=31536000, immutable

/city-photos/*
  Cache-Control: public, max-age=31536000, immutable

/portraits/*
  Cache-Control: public, max-age=31536000, immutable

/vendor-three-0.160.0.js
  Cache-Control: public, max-age=31536000, immutable

/bkk-photos/*
  Cache-Control: public, max-age=31536000, immutable
